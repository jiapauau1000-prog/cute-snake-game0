{
  "name": "manlu-travel",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:vite": "vite",
    "build": "next build && node scripts/migrate.mjs",
    "build:apk-web": "vite build",
    "start": "next start -p 3000",
    "lint": "oxlint",
    "preview": "vite preview",
    "cap:sync": "npm run build:apk-web && npx cap sync android",
    "apk:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "apk:release": "npm run cap:sync && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@electric-sql/pglite": "^0.3.15",
    "date-fns": "^4.1.0",
    "next": "^15.5.4",
    "pg": "^8.16.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  }
}
